{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build LÖVE",
      "type": "process",
      "command": "tools/build-love.sh",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Test",
